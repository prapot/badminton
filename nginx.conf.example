# Nginx config สำหรับ Next.js (badminton frontend)
# วางไฟล์นี้ที่: /etc/nginx/sites-available/badminton
# แล้วรัน: ln -s /etc/nginx/sites-available/badminton /etc/nginx/sites-enabled/

upstream nextjs_upstream {
    server 127.0.0.1:3000;
    keepalive 64;
}

upstream strapi_upstream {
    server 127.0.0.1:1337;
    keepalive 64;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    server_name yor-yae-bad.duckdns.org;
    return 301 https://$host$request_uri;
}

# HTTPS (SSL จาก Certbot / Let's Encrypt)
server {
    listen 443 ssl http2;
    server_name yor-yae-bad.duckdns.org;

    ssl_certificate     /etc/letsencrypt/live/yor-yae-bad.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yor-yae-bad.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 50m;

    # 1. Cache static files ของ Next.js
    location /_next/static/ {
        proxy_pass http://nextjs_upstream;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 2. Next.js API Routes (เช่น Pusher notification)
    location /api/pusher/ {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Strapi Uploads / Media files
    location /uploads/ {
        proxy_pass http://strapi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Strapi Admin Panel
    location /admin {
        proxy_pass http://strapi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. Strapi Content Manager
    location /content-manager/ {
        proxy_pass http://strapi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 6. Strapi API Routes
    location /api/ {
        proxy_pass http://strapi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 7. Next.js Frontend (Default)
    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
